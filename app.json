{
  "expo": {
    "name": "StatCam Hockey",
    "slug": "snypestat",
    "scheme": "statcamhockey",
    "version": "2.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon/logo_statcamHockey.png",
    "android": {
      "package": "ai.neuropuck.snypestat",
      "versionCode": 8,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/logo_statcamHockey.png",
        "backgroundColor": "#050D1A"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow StatCam Hockey to suggest the nearest ice rink when setting up a game."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon/logo_statcamHockey.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#050D1A",
          "dark": {
            "image": "./assets/icon/logo_statcamHockey.png",
            "backgroundColor": "#050D1A"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow StatCam Hockey to record the player's shifts.",
          "microphonePermission": "Allow StatCam Hockey to include rink audio in shift videos.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": false
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "3642405a-fde0-440d-b528-7db887261df2"
      }
    },
    "owner": "dokira"
  }
}
